PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bunny_cove?schema=public"
JWT_SECRET="bunny_cove_super_secret_jwt_key"
JWT_REFRESH_SECRET="bunny_cove_refresh_secret_jwt_key"

# Upstash Serverless Redis (Cloud)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"

# Cloudinary Media Storage (Avatars & Chat Images)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Gmail SMTP Sender
GMAIL_USER="your_email@gmail.com"
GMAIL_APP_PASSWORD="your_16_char_app_password"

# Firebase Cloud Messaging (FCM) - Remote Push Notifications
# Generated from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...\n-----END PRIVATE KEY-----\n"
# Or path to service account json file:
# FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
